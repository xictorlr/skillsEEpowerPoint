{
  "name": "slide-tools",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "author": "Victor Lopez Rapado (https://xictorlr.eu)",
  "description": "Panel de herramientas de alineación, tamaño, formato y texto para PowerPoint (Office.js).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs": "office-addin-dev-certs install",
    "manifest:dev": "bash scripts/make-dev-manifest.sh",
    "sideload:mac": "npm run manifest:dev && bash scripts/sideload-mac.sh manifest.dev.xml",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/office-js": "^1.0.612",
    "@vitest/coverage-v8": "^5.0.4",
    "happy-dom": "^21.0.1",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
